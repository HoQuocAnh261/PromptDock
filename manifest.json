{
  "id": "com.promptdock.desktop",
  "name": "PromptDock",
  "short_name": "PromptDock",
  "description": "Ultra-fast Windows 11 Desktop AI Prompt Manager. 100% Offline with Dynamic Variables auto-fill.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0f172a",
  "theme_color": "#111827",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "developer tools"
  ],
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icons/icon-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "screenshots": [
    {
      "src": "./icons/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "PromptDock Windows 11 Desktop AI Prompt Manager"
    },
    {
      "src": "./icons/screenshot-mobile.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "PromptDock Mobile & Compact View"
    }
  ],
  "shortcuts": [
    {
      "name": "Create New Prompt",
      "short_name": "New Prompt",
      "description": "Create a new AI prompt",
      "url": "./index.html?action=new",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Search Prompts",
      "short_name": "Search",
      "description": "Search AI prompts",
      "url": "./index.html?action=search",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Favorite Prompts",
      "short_name": "Favorites",
      "description": "View favorite prompts",
      "url": "./index.html?view=favorites",
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "name": "PromptDock JSON Export",
      "accept": {
        "application/json": [".json"]
      }
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "protocol_handlers": [
    {
      "protocol": "web+promptdock",
      "url": "./index.html?prompt=%s"
    }
  ],
  "share_target": {
    "action": "./index.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text"
    }
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "note_taking": {
    "new_note_url": "./index.html?action=new"
  },
  "widgets": [
    {
      "name": "PromptDock Quick Prompt",
      "description": "Quickly access your favorite prompts",
      "tag": "promptdock-quick",
      "template": "widget",
      "ms_ac_template": "widget.json",
      "data": "widget-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "./icons/screenshot-desktop.png",
          "sizes": "1280x720",
          "label": "PromptDock Widget"
        }
      ],
      "icons": [
        {
          "src": "./icons/icon-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "scope_extensions": [
    {
      "origin": "https://hoquocanh261.github.io"
    }
  ],
  "related_applications": [
    {
      "platform": "windows",
      "url": "https://www.microsoft.com/store/apps/PromptDock",
      "id": "PromptDock"
    }
  ],
  "prefer_related_applications": false
}
